{
  "name": "theobiproject",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "optimize-check": "node scripts/optimization-check.mjs",
    "db-phase2-check": "node scripts/db-phase2-check.mjs",
    "phase3-check": "node scripts/phase3-check.mjs",
    "phase4-check": "node scripts/phase4-check.mjs",
    "studio-functional-check": "node scripts/studio-functional-smoke.mjs",
    "studio-browser-check": "node scripts/studio-browser-e2e.mjs",
    "preview-isolation-check": "node scripts/preview-isolation-check.mjs",
    "verify": "node scripts/stability-check.mjs && node scripts/visual-phase1-check.mjs && node scripts/visual-phase2-check.mjs && node scripts/visual-phase3-check.mjs && node scripts/visual-phase4-check.mjs",
    "integration-check": "node scripts/integration-check.mjs && npm run studio-visual-phase4-check",
    "visual-browser-check": "node scripts/visual-phase4-browser.mjs",
    "studio-fields-check": "node scripts/studio-work-fields-check.mjs",
    "studio-visual-phase1-check": "node scripts/studio-visual-phase1-browser.mjs",
    "studio-visual-phase2-check": "node scripts/studio-visual-phase2-browser.mjs",
    "studio-visual-phase3-check": "node scripts/studio-visual-phase3-browser.mjs",
    "studio-visual-phase4-check": "node scripts/studio-visual-phase4-check.mjs",
    "home-volume-check": "node scripts/home-volume-check.mjs"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "esbuild": "^0.24.0"
  }
}
