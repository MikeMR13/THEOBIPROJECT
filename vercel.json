{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/public-meta?kind=home"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots"
    },
    {
      "source": "/serie/:slug",
      "destination": "/api/public-meta?kind=serie&slug=:slug"
    },
    {
      "source": "/leer/:slug/:chapter",
      "destination": "/api/public-meta?kind=leer&slug=:slug&chapter=:chapter"
    },
    {
      "source": "/equipo/:slug",
      "destination": "/api/public-meta?kind=equipo&slug=:slug"
    },
    {
      "source": "/lector/:slug",
      "destination": "/api/public-meta?kind=lector&slug=:slug"
    },
    {
      "source": "/mi-equipo",
      "destination": "/index.html"
    },
    {
      "source": "/catalogo",
      "destination": "/index.html"
    },
    {
      "source": "/calendario",
      "destination": "/index.html"
    },
    {
      "source": "/ranking",
      "destination": "/index.html"
    },
    {
      "source": "/lanzamientos",
      "destination": "/index.html"
    },
    {
      "source": "/biblioteca",
      "destination": "/index.html"
    },
    {
      "source": "/apoyar",
      "destination": "/index.html"
    },
    {
      "source": "/entrar",
      "destination": "/index.html"
    },
    {
      "source": "/registro",
      "destination": "/index.html"
    },
    {
      "source": "/restablecer",
      "destination": "/index.html"
    },
    {
      "source": "/perfil",
      "destination": "/index.html"
    },
    {
      "source": "/preferencias",
      "destination": "/index.html"
    },
    {
      "source": "/buscar",
      "destination": "/index.html"
    },
    {
      "source": "/solicitud",
      "destination": "/index.html"
    },
    {
      "source": "/elige-nombre",
      "destination": "/index.html"
    },
    {
      "source": "/privacidad",
      "destination": "/index.html"
    },
    {
      "source": "/condiciones-servicio",
      "destination": "/index.html"
    },
    {
      "source": "/invitacion",
      "destination": "/index.html"
    },
    {
      "source": "/bibliotecario",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/descargas",
      "destination": "/index.html"
    },
    {
      "source": "/anotaciones/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/estudio",
      "destination": "/index.html"
    },
    {
      "source": "/estudio/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://esm.sh https://qfllthjpjuaztppvpsrk.supabase.co https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://qfllthjpjuaztppvpsrk.supabase.co; font-src https://fonts.gstatic.com https://*.supabase.co blob: data:; img-src 'self' data: blob: https://*.supabase.co https://lh3.googleusercontent.com https://i.ytimg.com; connect-src 'self' https://challenges.cloudflare.com https://*.supabase.co wss://*.supabase.co https://esm.sh https://fonts.gstatic.com https://fonts.googleapis.com; worker-src 'self' blob:; frame-src 'self' https://challenges.cloudflare.com https://www.youtube-nocookie.com https://www.youtube.com; child-src 'self' blob:; frame-ancestors 'self'; object-src 'none'"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css)",
      "has": [
        {
          "type": "query",
          "key": "v"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(manifest.webmanifest|icon.svg|icon-192.png|icon-512.png|icon-maskable-512.png|apple-touch-icon.png|favicon-32.png)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/((?!.*\\.).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(index.html|sw.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(estudio|bibliotecario|admin|perfil|preferencias|biblioteca|descargas|entrar|registro|invitacion|solicitud|anotaciones)(/.*)?",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "functions": {
    "api/public-meta.js": {
      "includeFiles": "dist/index.html"
    },
    "api/sitemap.js": {
      "maxDuration": 30
    },
    "api/robots.js": {
      "maxDuration": 10
    }
  }
}
